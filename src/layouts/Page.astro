---
import "../styles/base.css";
import home from "../data/home-seo.json";
import contact from "../data/contact-seo.json";
import Nav from "../components/Nav.astro";
const seo = Astro.props.contact ? contact : home;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://assets.offthewall.studio" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <link rel="canonical" href={seo.canonical} />
    {seo.meta.map((m) => (
      <meta {...m} />
    ))}
    {seo.icons.map((i) => (
      <link {...i} />
    ))}
  <!-- Google Analytics -->
<script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-HBLQN93FBQ"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-HBLQN93FBQ');
</script>
<!-- End Google Analytics -->
</head>
  <body>
    <Nav />
    <slot />
  </body>
</html>
