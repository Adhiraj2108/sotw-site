---
import Page from "../layouts/Page.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import ProjectWall from "../components/ProjectWall.astro";
import data from "../data/studio.json";
const reviews = [
  [
    "19 December 2024/New York, USA",
    "Daniel Lin",
    "Central Park Web Designs",
    "Development Studio",
  ],
  [
    "08 January 2025/USA",
    "Ariel Childs",
    "Ariel Childs Coaching",
    "Lifestyle Coach",
  ],
];
---

<Page>
  <main>
    <Hero />
    <section class="about">
      <h2>
        What's <img src={data.mark} alt="" /> Studio
        <br />
        Off The Wall?
      </h2>
      <div class="copy">
        {data.about.map((line) => (
          <p>{line}</p>
        ))}
      </div>
      <a class="cta" href="/contact">
        Get in Touch
      </a>
    </section>
    <ProjectWall />
    {reviews.map(([date, name, business, role], i) => (
      <section class="review">
        <img
          class="tag"
          src={"https://sotw-assets.rae-social-agency.workers.dev/media/testimonial-" + (i + 1) + ".svg"}
          alt=""
        />
        <small>
          Testimonial 0{i + 1}
          <br />
          {date}
        </small>
        <div class="copy">
          {data.quotes.slice(i * 2, i * 2 + 2).map((q) => (
            <p>{q}</p>
          ))}
        </div>
        <h3>{name}</h3>
        <small class="review-role">
          {business}
          <br />({role})
        </small>
      </section>
    ))}
    <section class="services">
      <div>
        <h3>Our Services</h3>
        <p>but not limited to,</p>
        <ul>
          {[
            "Web Design",
            "Branding",
            "Framer Development",
            "Webflow Development",
            "App Design",
          ].map((s, i) => (
            <li>
              {s}
              <img src={"https://sotw-assets.rae-social-agency.workers.dev/media/service-" + (i + 1) + ".svg"} alt="" />
            </li>
          ))}
        </ul>
      </div>
    </section>
    <Gallery />
  </main>
  <Footer />
</Page>
<script>
  const reviews = [...document.querySelectorAll<HTMLElement>(".review")];
  let frame = 0;
  function updateTags() {
    frame = 0;
    const pin = innerWidth < 740 ? 132 : 160;
    const viewportHeight = innerHeight;
    reviews.forEach((review) => {
      const tag = review.querySelector<HTMLElement>(".tag")!;
      const role = review.querySelector<HTMLElement>(".review-role")!;
      // Measure both triggers against the tag's fixed viewport position.
      // Start 2vh before this section; finish 2vh after its role label.
      const start = review.getBoundingClientRect().top - viewportHeight * 0.02;
      const end = role.getBoundingClientRect().bottom + viewportHeight * 0.02;
      const visible = start <= pin && end > pin;
      tag.classList.toggle("is-visible", visible);
    });
  }
  function scheduleTags() {
    if (!frame) frame = requestAnimationFrame(updateTags);
  }
  addEventListener("scroll", scheduleTags, { passive: true });
  addEventListener("resize", scheduleTags);
  addEventListener("pageshow", scheduleTags);
  // Layout can shift as fonts and deferred media finish loading.
  new ResizeObserver(scheduleTags).observe(document.body);
  updateTags();
</script>
<style>
  .about,
  .review,
  .explore,
  .services {
    text-align: center;
  }
  .about {
    padding: 120px 40px;
  }
  .about img {
    height: 40px;
    vertical-align: baseline;
  }
  .copy {
    max-width: 620px;
    margin: 40px auto;
  }
  .copy p + p {
    margin-top: 20px;
    text-align: center;
  }
  .about .cta {
    margin-top: 8px;
  }
  .review {
    padding: 112px 48px;
  }
  .review .copy {
    margin-block: 48px;
  }
  .review small {
    text-transform: uppercase;
    display: block;
  }
  .review h3 {
    margin-bottom: 8px;
  }
  .services {
    padding: 40px 48px;
  }
  .services > div {
    background: var(--paper);
    padding: 80px 16px;
  }
  .services p {
    margin-top: 8px;
  }
  .services ul {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    font:
      56px/1.4 Lastik,
      serif;
  }
  @media (max-width: 739px) {
    .about {
      padding: 80px 16px 64px;
    }
    .about img {
      height: 28px;
    }
    .copy {
      margin: 24px auto;
    }
    .copy p + p {
      margin-top: 16px;
    }
    .review {
      padding: 80px 48px 64px;
    }
    .review .copy {
      margin: 32px auto;
    }
    .services {
      padding: 40px 16px;
    }
    .services > div {
      padding: 64px 8px;
    }
    .services ul {
      font-size: 32px;
      margin-top: 32px;
    }
  }

  .services li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    letter-spacing: -0.04em;
  }
  .services li img {
    height: 27px;
  }

  @media (min-width: 740px) and (max-width: 1439px) {
    .review {
      padding-block: 96px;
    }
    .services ul {
      font-size: 44px;
    }
    .services > div {
      padding-block: 64px;
    }
  }
  @media (min-width: 740px) and (max-width: 1099px) {
    .about {
      padding-block: 80px;
    }
    .review {
      padding-block: 80px;
    }
    .services > div {
      padding-block: 48px;
    }
  }
  @media (max-width: 739px) {
    .services li {
      gap: 8px;
    }
    .services li img {
      height: 16px;
    }
    .about .copy {
      margin-block: 32px;
    }
  }
  .review {
    position: relative;
  }
  .review > .tag {
    position: fixed;
    top: 160px;
    left: 50%;
    height: 27px;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    visibility: hidden;
    transition: opacity 100ms ease, visibility 0s linear 100ms;
  }
  .review > .tag.is-visible {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .review > .tag { transition: none; }
  }
  .review small:first-of-type {
    color: var(--muted);
  }
  @media (max-width: 739px) {
    .review > .tag {
      height: 20px;
      top: 132px;
    }
  }
</style>
