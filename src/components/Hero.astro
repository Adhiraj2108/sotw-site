---
import data from "../data/studio.json";
import StudioInfo from "./StudioInfo.astro";
const cards = [
  { name: "Hyphen Tracks", num: "04", images: [0] },
  { name: "M'Braun Residence", num: "02", images: [1] },
  { name: "Homers", num: "03", images: [2, 3] },
  { name: "Simple-things", num: "01", images: [4] },
];
---

<section class="hero">
  <div class="title">
    <p class="mono">Born by design, for design</p>
    <h1>
      Studio
      <br />
      Off &nbsp;The Wall
    </h1>
  </div>
  {cards.map(({ name, num, images }) => (
    <figure class={"piece p" + num}>
      <figcaption>
        <span>
          {num}. {name}
        </span>
        2024
      </figcaption>
      <div class="pictures">
        {images.map((i) => (
          <span class="print">
            <img {...data.hero[i]} draggable="false" />
          </span>
        ))}
      </div>
    </figure>
  ))}
  <StudioInfo />
</section>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".piece")];
  const order = [...cards];
  function raise(card: HTMLElement) {
    order.splice(order.indexOf(card), 1);
    order.push(card);
    order.forEach((item, index) => item.style.zIndex = String(index + 3));
  }
  cards.forEach((card) => {
    let x = 0, y = 0, startX = 0, startY = 0;
    let pointer: number | null = null;
    card.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") raise(card);
    });
    card.addEventListener("pointerdown", (event) => {
      if (!event.isPrimary || event.button !== 0 || pointer !== null) return;
      pointer = event.pointerId;
      card.setPointerCapture(pointer);
      startX = event.clientX - x;
      startY = event.clientY - y;
      card.classList.remove("dropped");
      card.classList.add("dragging");
      raise(card);
    });
    card.addEventListener("pointermove", (event) => {
      if (pointer !== event.pointerId) return;
      const hero = card.parentElement!;
      // Keep enough of the print visible to pick it up again after a drop.
      x = Math.max(48 - card.offsetLeft - card.offsetWidth,
        Math.min(hero.clientWidth - 48 - card.offsetLeft, event.clientX - startX));
      y = Math.max(80 - card.offsetTop,
        Math.min(hero.clientHeight - 100 - card.offsetTop - card.offsetHeight, event.clientY - startY));
      card.style.translate = `${x}px ${y}px`;
    });
    const release = (event: PointerEvent) => {
      if (pointer !== event.pointerId) return;
      pointer = null;
      card.classList.remove("dragging");
      card.classList.add("dropped");
      if (card.hasPointerCapture(event.pointerId)) card.releasePointerCapture(event.pointerId);
    };
    card.addEventListener("pointerup", release);
    card.addEventListener("pointercancel", release);
    card.addEventListener("lostpointercapture", release);
    card.addEventListener("pointerleave", () => card.classList.remove("dropped"));
  });
</script>
<style>
  .hero {
    height: 100svh;
    min-height: 540px;
    background: var(--paper);
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .title {
    text-align: center;
    position: relative;
    /* Dragged image layers are bounded at 6. */
    z-index: 7;
    color: var(--ink);
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .title > * {
    /* White source + difference renders black on paper and inverts images. */
    filter: invert(1);
    pointer-events: none;
  }
  .title p {
    text-transform: uppercase;
    margin-bottom: 16px;
    line-height: 1.2;
  }
  h1 {
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .hero :global(aside) {
    position: absolute;
    bottom: 0;
    width: 100%;
  }
  .piece {
    position: absolute;
    cursor: grab;
    touch-action: none;
    user-select: none;
    animation: appear 1.2s cubic-bezier(.12,.23,.14,.98) both;
    transition: transform 400ms cubic-bezier(.12,.23,.14,.98);
  }
  .piece.dragging {
    cursor: grabbing;
    transform: translateY(-8px) scale(1.025);
  }
  @media (hover: hover) {
    .piece:hover:not(.dropped) {
      transform: translateY(-8px) scale(1.025);
    }
    .piece:hover:not(.dropped) .print {
      box-shadow: 0 14px 22px #0002;
    }
  }
  .piece.dragging .print {
    box-shadow: 0 14px 22px #0002;
  }
  .pictures {
    display: flex;
    gap: 16px;
    width: 100%;
    height: 100%;
  }
  .print {
    position: relative;
    min-width: 0;
    flex: 1;
    border-radius: 6px;
    box-shadow: 0 3px 4px #0000001c;
    transition: box-shadow 400ms cubic-bezier(.12,.23,.14,.98);
  }
  .print::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 6px;
    box-shadow: inset 0 0 22px #ffffff80;
    pointer-events: none;
  }
  .pictures img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
  .piece figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 10px);
    display: flex;
    justify-content: space-between;
    text-transform: uppercase;
    font:
      10px/1.2 Mono,
      monospace;
    color: var(--muted);
  }
  .p03 figcaption,
  .p04 figcaption {
    top: calc(100% + 10px);
    bottom: auto;
  }
  .p01,
  .p02 {
    z-index: 2;
  }
  .p03,
  .p04 {
    z-index: 1;
  }
  .p02 {
    animation-delay: 0.35s;
  }
  .p03 {
    animation-delay: 0.55s;
  }
  .p01 {
    animation-delay: 0.75s;
  }
  .p04 {
    animation-delay: 0.95s;
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 739px) {
    .hero {
      height: 95svh;
    }
    .piece figcaption {
      font-size: 9px;
    }
    .pictures {
      gap: 3px;
    }
    h1 {
      font-size: 38px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece {
      animation: none;
      transition: none;
    }
    .piece .print {
      transition: none;
    }
    .piece.dragging, .piece:hover:not(.dropped) {
      transform: none;
    }
  }
  @media (min-width: 0px) {
    .p04 {
      left: calc(50% + -36px);
      top: calc(50% + 70.5px);
      width: 211px;
      height: 137px;
