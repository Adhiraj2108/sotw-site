---
import data from "../data/studio.json";
import StudioInfo from "./StudioInfo.astro";
const cards = [
  { name: "Hyphen Tracks", num: "04", images: [0] },
  { name: "M'Braun Residence", num: "02", images: [1] },
  { name: "Homers", num: "03", images: [2, 3] },
  { name: "Simple-things", num: "01", images: [4] },
];
---

<section class="hero">
  <div class="title">
    <p class="mono">Born by design, for design</p>
    <h1>
      Studio
      <br />
      Off &nbsp;The Wall
    </h1>
  </div>
  {cards.map(({ name, num, images }) => (
    <figure class={"piece p" + num}>
      <figcaption>
        <span>
          {num}. {name}
        </span>
        2024
      </figcaption>
      <div class="pictures">
        {images.map((i) => (
          <span class="print">
            <img {...data.hero[i]} draggable="false" />
          </span>
        ))}
      </div>
    </figure>
  ))}
  <StudioInfo />
</section>
<script>
  let layer = 4;
  document.querySelectorAll<HTMLElement>(".piece").forEach((card) => {
    let x = 0,
      y = 0,
      startX = 0,
      startY = 0;
    card.addEventListener("pointerdown", (event) => {
      card.setPointerCapture(event.pointerId);
      startX = event.clientX - x;
      startY = event.clientY - y;
      card.style.zIndex = String(++layer);
    });
    card.addEventListener("pointermove", (event) => {
      if (!card.hasPointerCapture(event.pointerId)) return;
      x = event.clientX - startX;
      y = event.clientY - startY;
      card.style.translate = x + "px " + y + "px";
    });
  });
</script>
<style>
  .hero {
    height: 100svh;
    min-height: 540px;
    background: var(--paper);
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .title {
    text-align: center;
    position: relative;
    z-index: 2;
    pointer-events: none;
  }
  .title p {
    text-transform: uppercase;
    margin-bottom: 16px;
    line-height: 1.2;
  }
  h1 {
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .hero :global(aside) {
    position: absolute;
    bottom: 0;
    width: 100%;
  }
  .piece {
    position: absolute;
    cursor: grab;
    touch-action: none;
    user-select: none;
    animation: appear 0.8s both;
  }
  .piece:active {
    cursor: grabbing;
  }
  .pictures {
    display: flex;
    gap: 16px;
    width: 100%;
    height: 100%;
  }
  .print {
    position: relative;
    min-width: 0;
    flex: 1;
  }
  .print::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 6px;
    box-shadow: inset 0 0 22px #ffffff80;
    pointer-events: none;
  }
  .pictures img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
  .piece figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 10px);
    display: flex;
    justify-content: space-between;
    text-transform: uppercase;
    font:
      10px/1.2 Mono,
      monospace;
    color: var(--muted);
  }
  .p03 figcaption,
  .p04 figcaption {
    top: calc(100% + 10px);
    bottom: auto;
  }
  .p01,
  .p02 {
    z-index: 2;
  }
  .p03,
  .p04 {
    z-index: 1;
  }
  .p03 {
    animation-delay: 0.4s;
  }
  .p01 {
    animation-delay: 0.6s;
  }
  .p04 {
    animation-delay: 0.8s;
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (max-width: 739px) {
    .hero {
      height: 95svh;
    }
    .piece figcaption {
      font-size: 9px;
    }
    .pictures {
      gap: 3px;
    }
    h1 {
      font-size: 38px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .piece {
      animation: none;
    }
  }
  @media (min-width: 0px) {
    .p04 {
      left: calc(50% + -36px);
      top: calc(50% + 70.5px);
      width: 211px;
      height: 137px;
    }
    .p02 {
      left: calc(50% + -7px);
      top: calc(50% + -220.5px);
      width: 167px;
      height: 131px;
    }
    .p03 {
      left: calc(50% + -173px);
      top: calc(50% + 100.5px);
      width: 177px;
      height: 171px;
    }
    .p01 {
      left: calc(50% + -178px);
      top: calc(50% + -266.5px);
      width: 211px;
      height: 121px;
    }
  }
  @media (min-width: 740px) {
    .p04 {
      left: calc(50% + 129px);
      top: calc(50% + 60px);
      width: 193px;
      height: 125px;
    }
    .p02 {
      left: calc(50% + 152px);
      top: calc(50% + -232px);
      width: 234px;
      height: 183px;
    }
    .p03 {
      left: calc(50% + -352px);
      top: calc(50% + -6px);
      width: 204px;
      height: 197px;
    }
    .p01 {
      left: calc(50% + -381px);
      top: calc(50% + -254px);
      width: 310px;
      height: 178px;
    }
  }
  @media (min-width: 1100px) {
    .p04 {
      left: calc(50% + 136px);
      top: calc(50% + -8px);
      width: 326px;
      height: 211px;
    }
    .p02 {
      left: calc(50% + 172px);
      top: calc(50% + -207px);
      width: 325px;
      height: 254px;
    }
    .p03 {
      left: calc(50% + -420px);
      top: calc(50% + -45px);
      width: 272px;
      height: 262px;
    }
    .p01 {
      left: calc(50% + -525px);
      top: calc(50% + -243px);
      width: 427px;
      height: 245px;
    }
  }
  @media (min-width: 1440px) {
    .p04 {
      left: calc(50% + 153px);
      top: calc(50% + 0px);
      width: 326px;
      height: 211px;
    }
    .p02 {
      left: calc(50% + 189px);
      top: calc(50% + -215px);
      width: 325px;
      height: 254px;
    }
    .p03 {
      left: calc(50% + -437px);
      top: calc(50% + -38px);
      width: 272px;
      height: 262px;
    }
    .p01 {
      left: calc(50% + -542px);
      top: calc(50% + -251px);
      width: 427px;
      height: 245px;
    }
  }
  @media (min-width: 1920px) {
    .p04 {
      left: calc(50% + 173px);
      top: calc(50% + 10px);
      width: 326px;
      height: 211px;
    }
    .p02 {
      left: calc(50% + 209px);
      top: calc(50% + -225px);
      width: 325px;
      height: 254px;
    }
    .p03 {
      left: calc(50% + -467px);
      top: calc(50% + -38px);
      width: 272px;
      height: 262px;
    }
    .p01 {
      left: calc(50% + -582px);
      top: calc(50% + -251px);
      width: 427px;
      height: 245px;
    }
  }
  @media (min-width: 740px) and (max-width: 1439px) {
    h1 {
      font-size: 45px;
    }
    .title p {
      font-size: 12px;
    }
  }
</style>
