---
import data from "../data/studio.json";
---

<section class="projects">
  <header>
    <h2>Project Wall</h2>
    <p>
      A selection of committed projects that we've had the opportunity to work
      on.
    </p>
  </header>
  <div class="grid">
    {data.projects.map((p) => (
      <a class="project" href={p.url} target="_blank">
        <figure>
          <video muted playsinline preload="none" data-stream={p.video}></video>
          <img src={p.image.src} alt={p.image.alt} loading="lazy" />
        </figure>
        <div class="row">
          <h3>{p.name}</h3>
          <small>↗ Visit Website</small>
        </div>
        <p>{p.desc}</p>
      </a>
    ))}
  </div>
</section>
<script>
  for (const card of document.querySelectorAll<HTMLAnchorElement>(".project")) {
    const video = card.querySelector("video")!;
    let initialization: Promise<void> | null = null;
    let hls: import("hls.js/light").default | null = null;
    let active = false;
    let frame: number | null = null;
    let startupQuality = true;

    async function initialize() {
      const url = video.dataset.stream!;
      if (video.canPlayType("application/vnd.apple.mpegurl")) {
        // Native HLS doesn't expose startup-level selection. Use its 720p rendition.
        video.src = new URL("720p/video.m3u8", url).href;
        return;
      }
      const { default: Hls } = await import("hls.js/light");
      if (!Hls.isSupported()) throw new Error("HLS playback is unavailable");
      hls = new Hls({ autoStartLoad: false, testBandwidth: false });
      await new Promise<void>((resolve, reject) => {
        hls!.on(Hls.Events.MANIFEST_PARSED, () => {
          const level = hls!.levels.findIndex(level => level.height === 720);
          const start = level >= 0 ? level : hls!.levels.length - 1;
          hls!.startLevel = start;
          // Keep the first frame sharp, even before bandwidth has been measured.
          hls!.loadLevel = start;
          hls!.startLoad();
          resolve();
        });
        hls!.on(Hls.Events.ERROR, (_event, data) => {
          if (!data.fatal) return;
          hls?.destroy();
          hls = null;
          initialization = null;
          startupQuality = true;
          card.classList.remove("playing");
          reject(new Error("Unable to load preview"));
        });
        hls!.loadSource(url);
        hls!.attachMedia(video);
      });
    }
    async function preview() {
      active = true;
      try {
        initialization ??= initialize();
        await initialization;
        if (active) await video.play();
      } catch {
        card.classList.remove("playing");
      }
    }
    function cancelFrame() {
      if (frame !== null) video.cancelVideoFrameCallback(frame);
      frame = null;
    }
    function reveal() {
      frame = null;
      if (!active || video.paused || video.readyState < 2) return;
      card.classList.add("playing");
      if (startupQuality) {
        startupQuality = false;
        // After the first sharp frame, hls.js can adapt to connection speed.
        if (hls) hls.loadLevel = -1;
      }
    }
    function stop() {
      active = false;
      cancelFrame();
      video.pause();
      if (video.readyState) video.currentTime = 0;
      card.classList.remove("playing");
    }
    video.addEventListener("playing", () => {
      if (!active) { video.pause(); return; }
      cancelFrame();
      // Keep the cover until the browser has actually rendered a video frame.
      if ("requestVideoFrameCallback" in video) frame = video.requestVideoFrameCallback(reveal);
      else reveal();
    });
    video.addEventListener("error", () => card.classList.remove("playing"));
    card.addEventListener("pointerenter", preview);
    card.addEventListener("focus", preview);
    card.addEventListener("pointerleave", stop);
    card.addEventListener("blur", stop);
    card.addEventListener("touchend", stop, { passive: true });
  }
</script>
<style>
  .projects {
    padding: 20px 24px 40px;
  }
  .projects header {
    text-align: center;
    max-width: 370px;
    margin: 0 auto 40px;
  }
  .projects header p {
    margin-top: 8px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }
  .project {
    text-decoration: none;
  }
  .project figure {
    aspect-ratio: 1.6;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
  }
  .project img,
  .project video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .project img {
    transition: opacity 0.25s;
  }
  .playing img {
    opacity: 0;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 16px 0 12px;
    gap: 8px;
  }
  .row h3 {
    font-size: 28px;
  }
  .row small {
    text-transform: uppercase;
    white-space: nowrap;
  }
  .project p {
    font:
      14px/1.3 Geist,
      sans-serif;
  }
  @media (max-width: 739px) {
    .projects {
      padding-inline: 16px;
    }
    .projects header {
      margin-bottom: 24px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .row h3 {
      font-size: 22px;
    }
    .project p {
      font-size: 12px;
    }
  }
  @media (min-width: 1920px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
