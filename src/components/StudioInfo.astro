<script>
  const clock = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Kolkata",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
  });
  function tick() {
    document
      .querySelectorAll("aside time")
      .forEach((t) => (t.textContent = clock.format(new Date())));
  }
  tick();
  setInterval(tick, 1000);
</script>
