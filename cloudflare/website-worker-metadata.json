{
  "main_module": "worker.js",
  "compatibility_date": "2026-11-09",
  "bindings": [{ "type": "assets", "name": "ASSETS" }],
  "keep_assets": true,
  "assets": { "config": { "html_handling": "drop-trailing-slash", "not_found_handling": "404-page", "run_worker_first": true } },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
